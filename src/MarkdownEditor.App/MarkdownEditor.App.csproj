<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MarkdownEditor</AssemblyName>
    <RootNamespace>MarkdownEditor.App</RootNamespace>
    <!-- Exe icon: taskbar, Start menu, and the .md file association (DefaultIcon = exe,0). -->
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Window title-bar icon. -->
    <Resource Include="Assets\app-icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MarkdownEditor.App.Tests" />
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MarkdownEditor.Core\MarkdownEditor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compact the Large Object Heap more eagerly (large documents and HTML strings live there). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Editing\Markdown.xshd" />
  </ItemGroup>
  <!-- Bundled plugins: restored and built as (non-referenced) dependencies, then staged under plugins/<name>/ -->
  <ItemGroup>
    <BundledPlugin Include="..\..\plugins\*\*.csproj" />
    <ProjectReference Include="@(BundledPlugin)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="StageBundledPlugins" AfterTargets="Build" DependsOnTargets="CollectBundledPluginFiles">
    <Copy SourceFiles="@(_PluginFiles)" DestinationFiles="@(_PluginFiles->'$(OutDir)plugins\%(PluginName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- Publish output (used by the installer) gets the same plugins/<name>/ layout as the build output. -->
  <Target Name="PublishBundledPlugins" AfterTargets="Publish" DependsOnTargets="CollectBundledPluginFiles">
    <Copy SourceFiles="@(_PluginFiles)" DestinationFiles="@(_PluginFiles->'$(PublishDir)plugins\%(PluginName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CollectBundledPluginFiles">
    <!-- Plugins are RID-agnostic: drop the app's RID so the paths match where the ProjectReference built them. -->
    <MSBuild Projects="@(BundledPlugin)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;PublishReadyToRun">
      <Output TaskParameter="TargetOutputs" ItemName="_PluginAssembly" />
    </MSBuild>
    <ItemGroup>
      <_PluginFiles Include="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)**\*.*"
                    PluginName="$([System.String]::Copy('%(_PluginAssembly.Filename)').Replace('MarkdownEditor.Plugin.', '').ToLowerInvariant())"
                    Exclude="%(_PluginAssembly.RootDir)%(_PluginAssembly.Directory)**\*.pdb" />
    </ItemGroup>
  </Target>
</Project>
