<Window x:Class="MarkdownEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Markdown Editor" Height="800" Width="1300" AllowDrop="True">
    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="OnNew" />
        <CommandBinding Command="Open" Executed="OnOpen" />
        <CommandBinding Command="Save" Executed="OnSave" />
        <CommandBinding Command="SaveAs" Executed="OnSaveAs" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="SaveAs" Modifiers="Ctrl+Shift" Key="S" />
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Command="New" />
                <MenuItem Command="Open" />
                <MenuItem Command="Save" />
                <MenuItem Command="SaveAs" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Export to _HTML..." Click="OnExportHtml" />
                <MenuItem Header="Export to _PDF..." Click="OnExportPdf" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Plugins..." Click="OnShowPlugins" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem x:Name="StatusText" />
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <avalon:TextEditor x:Name="Editor" Grid.Column="0" FontFamily="Cascadia Mono, Consolas"
                               FontSize="14" ShowLineNumbers="True" WordWrap="True" Padding="4" />
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
            <wv2:WebView2 x:Name="Preview" Grid.Column="2" />
        </Grid>
    </DockPanel>
</Window>
